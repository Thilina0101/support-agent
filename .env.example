# Copy this file to ".env" and fill it in. Never share .env or put it on GitHub.

# Claude API key (https://platform.claude.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# ---- LINE (only needed for line-server.mjs) — see LINE-SETUP.md ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional: your own LINE user ID, so you get a LINE message when a customer is handed over to staff
STAFF_LINE_ID=

# ---- WhatsApp Cloud API (only needed for WhatsApp) — see WHATSAPP-SETUP.md ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any text you choose; type the same text in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Optional: staff WhatsApp number for hand-off alerts (only delivered if that phone messaged the business in the last 24h)
STAFF_WHATSAPP=
# WHATSAPP_API_VERSION=v23.0

# ---- Facebook Page / Messenger (only needed for Messenger) — see MESSENGER-SETUP.md ----
MESSENGER_PAGE_TOKEN=
MESSENGER_PAGE_ID=
# App ID: lets the bot go quiet when staff reply by hand in the Page inbox
MESSENGER_APP_ID=
# App secret (can be left empty if it's the same Meta app as WhatsApp)
MESSENGER_APP_SECRET=
# Any text you choose; type the same text in Meta's webhook settings
MESSENGER_VERIFY_TOKEN=

# Karena POS: the Google Apps Script Web App URL (POS → Settings → Google Sheet Web App URL, ends in /exec)
MENU_API_URL=https://script.google.com/macros/s/.../exec

# ---- Optional settings ----
# BUSINESS_DIR=business-karena     # which business folder the LINE server uses (default business-karena)
# CHAT_EFFORT=low                  # low = fast replies; medium = more careful (LINE + WhatsApp)
# HANDOFF_HOURS=12                 # how long the bot stays quiet after handing a customer to staff
# SESSION_MINUTES=60               # a chat idle this long starts a fresh conversation
# PORT=3000
